{
  "name": "jay-portfolio-content-admin",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "wrangler deploy --dry-run --outdir dist/worker",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:api": "node scripts/check-config.js && wrangler deploy",
    "preview": "node scripts/preview.js",
    "configure": "node scripts/configure-admin.js"
  },
  "dependencies": { "jose": "^6.1.0", "parse5": "^8.0.0" },
  "devDependencies": { "wrangler": "^4.35.0" }
}
